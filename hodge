<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hodge Memorial — Skins</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;700;900&family=Oswald:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --felt:#123829; --felt-deep:#0c2a1f; --cream:#f2e9d4; --cream-dim:#c9bfa4;
    --gold:#d4a92c; --usa:#8fb7e8; --mi:#e8a48f; --line:#2a5a44;
  }
  *{box-sizing:border-box;margin:0}
  body{
    background:
      radial-gradient(1200px 500px at 50% -10%, #1a4a36, transparent),
      var(--felt);
    color:var(--cream);
    font-family:'Oswald',sans-serif;
    letter-spacing:.02em;
    min-height:100vh;
    padding:0 16px 64px;
  }
  header{max-width:680px;margin:0 auto;padding:40px 0 8px;text-align:center;border-bottom:3px double var(--gold)}
  .annual{font-size:14px;color:var(--cream-dim);font-weight:400}
  h1{font-family:'Bitter',serif;font-weight:900;font-size:clamp(34px,8vw,54px);line-height:1.05;color:var(--gold)}
  h1 span{display:block;font-size:.42em;font-weight:700;color:var(--cream);margin-top:2px}
  main{max-width:680px;margin:0 auto}
  .pot{
    display:flex;justify-content:center;align-items:baseline;gap:10px;
    padding:18px 0 6px;font-size:15px;color:var(--cream-dim);flex-wrap:wrap
  }
  .pot input{
    width:64px;background:var(--felt-deep);border:1px solid var(--line);
    color:var(--gold);font:inherit;font-size:17px;text-align:center;padding:3px 4px;border-radius:3px
  }
  .pot output{color:var(--gold);font-size:17px}
  section{margin-top:34px}
  h2{
    font-family:'Bitter',serif;font-weight:700;font-size:19px;color:var(--cream);
    padding-bottom:6px;border-bottom:1px solid var(--line);margin-bottom:2px
  }
  h2 small{font-family:'Oswald';font-weight:400;font-size:13px;color:var(--cream-dim);float:right;padding-top:6px}
  .row{
    display:flex;align-items:baseline;gap:12px;
    padding:9px 2px;border-bottom:1px solid var(--line)
  }
  .row:last-child{border-bottom:none}
  .hole{
    min-width:52px;color:var(--cream-dim);font-size:13px
  }
  .who{flex:1;font-size:17px}
  .who em{font-style:normal;font-size:12px;margin-left:8px;padding:1px 6px;border-radius:2px;vertical-align:middle}
  .t-USA em{background:#1c3a5c;color:var(--usa)}
  .t-Michigan em{background:#5c2a1c;color:var(--mi)}
  .net{font-family:'Bitter',serif;font-weight:700;color:var(--gold);min-width:34px;text-align:right}
  .money{color:var(--cream-dim);font-size:14px;min-width:64px;text-align:right}
  /* leaderboard */
  .lead .who{font-size:18px}
  .lead .count{font-family:'Bitter',serif;font-weight:900;font-size:22px;color:var(--gold);min-width:30px;text-align:right}
  .kicker{margin-top:10px;font-size:14px;color:var(--cream-dim);line-height:1.5}
  .state{padding:60px 0;text-align:center;color:var(--cream-dim)}
  footer{max-width:680px;margin:44px auto 0;text-align:center;font-size:13px;color:var(--cream-dim)}
  footer a{color:var(--gold)}
  @media (prefers-reduced-motion:no-preference){
    main{animation:up .5s ease both}
    @keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  }
</style>
</head>
<body>
<header>
  <p class="annual">The Eleventh Annual Hodge Memorial</p>
  <h1>Skins<span>net only · won outright · no carryovers</span></h1>
</header>

<main>
  <div class="pot">
    Buy-in $<input id="buyin" type="number" value="20" min="0" step="5" inputmode="numeric">
    per man × <span id="nplayers">–</span> players →
    <output id="perskin">–</output> per skin
  </div>
  <div id="app" class="state">Pulling the ledger…</div>
</main>

<footer>
  <a href="board.html">Board</a> · <a href="cup.html">Cup</a> · <a href="talk.html">Trash Talk</a>
</footer>

<script>
const ROUND_LABEL = {
  1:'Round 1 — Scramble · Hawk\u2019s Eye',
  2:'Round 2 — Best Ball · Cedar River',
  3:'Round 3 — Alternate Shot · Summit front',
  4:'Round 4 — Best Ball · Summit back',
  5:'Round 5 — Singles · The Legend'
};
let DATA=null;

async function load(){
  for(const src of ['hodge-2026-results.json','hodge']){
    try{
      const r=await fetch(src,{cache:'no-store'});
      if(r.ok){DATA=await r.json();break;}
    }catch(e){}
  }
  const app=document.getElementById('app');
  if(!DATA||!DATA.net_skins){app.className='state';app.textContent='Couldn\u2019t load results. Check that the JSON is in the repo next to this page.';return;}
  render();
}

function money(n){return '$'+(Math.round(n*100)/100).toLocaleString(undefined,{maximumFractionDigits:2});}

function render(){
  const s=DATA.net_skins;
  const nPlayers=Object.keys(DATA.players||{}).length||24;
  document.getElementById('nplayers').textContent=nPlayers;

  const app=document.getElementById('app');
  app.className='';
  app.innerHTML='';

  // leaderboard
  const lead=document.createElement('section');
  lead.className='lead';
  lead.innerHTML='<h2>Skin count<small>'+s.total_skins+' skins total</small></h2>';
  for(const [name,count] of Object.entries(s.skin_count)){
    const team=teamOf(name);
    lead.insertAdjacentHTML('beforeend',
      `<div class="row t-${team}"><div class="who">${name}<em>${team==='Michigan'?'MI':team}</em></div>
       <div class="money" data-skins="${count}"></div>
       <div class="count">${count}</div></div>`);
  }
  app.appendChild(lead);

  // by round
  for(const rnd of Object.keys(s.by_round)){
    const sec=document.createElement('section');
    const skins=s.by_round[rnd];
    sec.innerHTML='<h2>'+ROUND_LABEL[rnd]+'<small>'+skins.length+(skins.length===1?' skin':' skins')+'</small></h2>';
    if(!skins.length){sec.insertAdjacentHTML('beforeend','<div class="kicker">Nothing survived — every low ball got pushed.</div>');}
    for(const k of skins){
      sec.insertAdjacentHTML('beforeend',
        `<div class="row t-${k.team}"><div class="hole">Hole ${k.hole}</div>
         <div class="who">${k.winner}<em>${k.team==='Michigan'?'MI':k.team}</em></div>
         <div class="net">${k.net_to_par}</div></div>`);
    }
    app.appendChild(sec);
  }

  const note=document.createElement('p');
  note.className='kicker';
  note.textContent='Pairs are one entrant in Scramble and Alternate Shot (one shared ball) and split their skin. Best Ball and Singles pay individuals.';
  app.appendChild(note);

  wireMoney(nPlayers);
  document.getElementById('buyin').addEventListener('input',()=>wireMoney(nPlayers));
}

function wireMoney(nPlayers){
  const s=DATA.net_skins;
  const buy=parseFloat(document.getElementById('buyin').value)||0;
  const per=s.total_skins?buy*nPlayers/s.total_skins:0;
  document.getElementById('perskin').textContent=money(per);
  document.querySelectorAll('.money[data-skins]').forEach(el=>{
    el.textContent=money(per*parseInt(el.dataset.skins,10));
  });
}

function teamOf(name){
  // pair labels like "A / B" — take first name's team
  const first=name.split(' / ')[0];
  const t=DATA.teams;
  if(t.USA.includes(first))return 'USA';
  if(t.Michigan.includes(first))return 'Michigan';
  return 'USA';
}

load();
</script>
</body>
</html>
